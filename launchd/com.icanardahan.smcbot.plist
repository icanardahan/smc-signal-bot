<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.icanardahan.smcbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/icanardahan/smc-signal-bot/run_local.sh</string>
  </array>
  <!-- StartCalendarInterval, StartInterval'dan farklı olarak takvim tabanlı
       çalışır ve kullanıcının kidshorts projesinde gece 01:00/03:00'te
       güvenilir biçimde tetiklendiği görüldü. Her saatin 20. dakikası. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key><integer>20</integer>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/icanardahan/smc-signal-bot/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/icanardahan/smc-signal-bot/logs/launchd.err</string>
</dict>
</plist>
