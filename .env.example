# Gerçek para ayarları — bu dosyayı `.env` olarak KOPYALA ve doldur.
# .env asla git'e girmez (.gitignore'da).
#
# API anahtarını Binance'te şu izinlerle oluştur:
#   - Enable Futures  : AÇIK
#   - Enable Withdrawals : KAPALI  (bot para çekmez, açık olmamalı)
#   - Enable Spot Trading : KAPALI (bot yalnızca vadeli işlem açar)
# Anahtarları buraya sen yapıştır; ben görmüyorum ve görmemeliyim.

BINANCE_API_KEY=buraya_gercek_api_key
BINANCE_API_SECRET=buraya_gercek_secret

# 0 = GERÇEK PARA. İlk kurulumda 1 bırakıp bir koşu izlemeni öneririm.
BINANCE_TESTNET=0
# 1 = emir GÖNDERİLMEZ (prova). İlk koşuyu 1 ile yap, logu gör, sonra 0 yap.
BINANCE_DRY_RUN=1
BINANCE_TRADING_ENABLED=1

# Telegram
# DİKKAT: chat_id, token'ın iki nokta ÖNCESİNDEKİ sayı DEĞİLDİR — o botun
# kendi kimliğidir ve bot kendine mesaj atamaz ("the bot can't send messages
# to the bot"). Bu hata iki kez yaşandı.
# Doğru kimlik: bota /start yazdıktan sonra
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | grep -o '"id":[0-9]*'
TELEGRAM_BOT_TOKEN=buraya_telegram_token
TELEGRAM_CHAT_ID=1105401433

# Strateji ayarları
SMC_MAX_OPEN=5        # aynı anda açık pozisyon (5 x %2 = bakiyenin %10'u riskte)
SMC_RISK_PCT=2.0      # işlem başına riske edilen bakiye yüzdesi
SMC_DIR=              # boş = long + short

# launchd'nin pyenv kabuklarını görmemesi için tam python yolu
SMC_PYTHON=/Users/icanardahan/.pyenv/versions/3.10.18/Library/Frameworks/Python.framework/Versions/3.10/bin/python3
